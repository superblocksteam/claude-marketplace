{
  "mcpServers": {
    "superblocks": {
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/scripts/launch-mcp.mjs"
      ],
      "env": {
        "NODE_DEBUG": "gateway",
        "NPM_CONFIG_PACKAGE": "@superblocksteam/cli@beta",
        "SUPERBLOCKS_MCP_BROWSER_LOGIN": "true",
        "SUPERBLOCKS_SERVER_URL": "https://app.superblocks.com"
      }
    }
  }
}
