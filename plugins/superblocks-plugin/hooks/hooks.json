{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/guidance.sh\" SessionStart"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^mcp__remote-devices__plugin_.*_superblocks__.*",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/guidance.sh\" PostToolUse"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "^mcp__remote-devices__plugin_.*_superblocks__.*",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/guidance.sh\" PostToolUseFailure"
          }
        ]
      }
    ]
  }
}
